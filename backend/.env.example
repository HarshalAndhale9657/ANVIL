# ── ANVIL / A.E.G.I.S. — Environment Variables ──────────────────────────────
# Copy to backend/.env and fill in. Every variable is read in app/config.py.

# ── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# GitHub OAuth App (github.com/settings/developers). The callback URL registered
# on the app must equal GITHUB_REDIRECT_URI exactly.
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-32-byte-string

# Where the browser is sent after login (no trailing slash).
FRONTEND_URL=http://localhost:5173

# ── Session cookie ───────────────────────────────────────────────────────────
# Production: COOKIE_SECURE=true (HTTPS). Keep SameSite=lax — production serves
# the API same-origin behind the frontend's /api proxy. COOKIE_SECURE=true also
# makes startup refuse the placeholder SESSION_SECRET.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Hosted-deployment guardrails (defaults are permissive for local dev) ─────
# Owners whose repos may be scanned: "*" = any, "@self" = the signed-in user's
# own repos, or comma-separated GitHub owners, e.g. "acme,@self".
SCAN_ALLOWED_OWNERS=*
# Optional deliberately-vulnerable repo offered as a one-click demo in the UI.
DEMO_REPO_URL=
# Without push access the repo is forked and the PR opened IN THE FORK; set
# true to open it against the upstream repo instead.
ALLOW_UPSTREAM_PRS=false
MAX_CONCURRENT_SCANS=4
MAX_ACTIVE_SCANS_PER_USER=1
# Rolling-24h caps, 0 = unlimited.
MAX_SCANS_PER_USER_PER_DAY=0
MAX_SCANS_PER_DAY=0

# ── Pipeline tuning ──────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MAX_RETRIES=3
# Live re-exploit gate: relaunch the patched app and require the exploit to fail.
LIVE_PATCH_GATE=true
PATCH_MAX_ATTEMPTS=3
# Tool-using exploit agent (probe the live target, then reproduce). Off by default.
AGENTIC_EXPLOIT=false
AGENTIC_EXPLOIT_MAX_STEPS=8

# ── Storage ──────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=master_state.db
# SCAN_TEMP_DIR=./scans

# ── Omium / OpenTelemetry (optional) ─────────────────────────────────────────
OMIUM_API_KEY=
OMIUM_ENDPOINT=https://api.omium.ai
SERVICE_NAME=red-team-engine
